# ── Core ──────────────────────────────────────────────────────────────
# Postgres connection. In production: enable SSL (sslmode=require).
DATABASE_URL=postgres://user:pass@localhost:5432/ranke?sslmode=disable

# Generate with: openssl rand -hex 32   (must be >= 32 chars; startup fails otherwise)
JWT_SECRET=change-me-to-a-256-bit-random-hex-of-at-least-32-chars

# Token lifetimes — keep access short, refresh long. Refresh tokens are
# rotated on every use, so a long TTL is safe in practice.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# HTTP listen port.
PORT=8080

# Apple Sign-In bundle ID. REQUIRED in production (App Store policy when
# any social login is offered).
APPLE_BUNDLE_ID=com.yourcompany.rankapp

# ── Environment ───────────────────────────────────────────────────────
# "development", "staging", "production". Production enables gin release
# mode and enforces strict CORS / secret checks.
ENV=development

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated allowlist. REQUIRED in production; "*" is rejected.
# In development, leaving this empty mirrors the caller's origin (for
# Flutter web hot-reload).
# Example: ALLOWED_ORIGINS=https://app.ranke.example,https://staging.ranke.example
ALLOWED_ORIGINS=

# ── HTTP server timeouts ──────────────────────────────────────────────
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s

# Max request body size in bytes. Defaults to 1 MiB.
MAX_BODY_BYTES=1048576

# ── PostgreSQL pool ───────────────────────────────────────────────────
DB_MAX_CONNS=25
DB_MIN_CONNS=2
